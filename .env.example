# Copie este archivo a .env y ajuste los valores. NUNCA suba el .env real al repositorio.

# --- PostgreSQL ---
POSTGRES_DB=punto_venta
POSTGRES_USER=pos
POSTGRES_PASSWORD=cambie-esta-contrasena

# --- API ---
# Clave HMAC para firmar los JWT: mínimo 32 caracteres aleatorios (p. ej. `openssl rand -base64 48`).
JWT_KEY=reemplace-por-una-clave-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=480
# true = crea usuarios, productos y ventas de demostración al primer arranque.
SEED_DEMO_DATA=true
SWAGGER_ENABLED=true

# --- Puertos publicados en el host ---
API_PORT=5080
WEB_PORT=8080
